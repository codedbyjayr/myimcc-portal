# MyIMCC Portal — Production Environment Variables
# Copy this file to `.env` and fill in your real values.

# ── Supabase ──────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=***
SUPABASE_SERVICE_ROLE_KEY=***

# ── Groq AI (LLM for answer generation — FREE tier) ──────────────────
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=***
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings (FREE — no API key needed) ────────────────────────────
# Embeddings are generated locally inside the Edge Function using
# @xenova/transformers (all-MiniLM-L6-v2, 384 dimensions).
# No OpenAI key required. No external API. Zero cost.
# The model downloads on first request and is cached for subsequent calls.

# ── Google OAuth (SSO) ───────────────────────────────────────────────
# Set up in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_PROJECT_ID.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id

# ── Ngrok ────────────────────────────────────────────────────────────
# Get this from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=***
# The domain ngrok assigns (or your reserved domain)
NGROK_DOMAIN=your-reserved-domain.ngrok.app

# ── Portal Config ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
SCHOOL_NAME=Iligan Medical Center College
SCHOOL_SHORT_NAME=MyIMCC
SUPPORT_EMAIL=support@imcc.edu.ph
REGISTRAR_EMAIL=registrar@imcc.edu.ph

# Allowed institutional email suffixes (comma-separated)
ALLOWED_EMAIL_SUFFIXES=@student.imcc.edu.ph,@faculty.imcc.edu.ph,@admin.imcc.edu.ph,@imcc.edu.ph
